# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DATABASE_URL="mysql://blockcert:blockcert123@localhost:3307/blockcert"

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ─── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated list for multiple origins (staging + production)
ALLOWED_ORIGINS=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
VERIFY_RATE_LIMIT_WINDOW_MS=900000
VERIFY_RATE_LIMIT_MAX=60

# ─── File Upload Security ─────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf

# ─── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Polygon Amoy Blockchain ──────────────────────────────────────────────────
# Primary env var names (required)
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix
CONTRACT_ADDRESS=0xYourDeployedCertificateRegistryAddress
CHAIN_ID=80002

# Transaction tuning (optional)
TX_TIMEOUT_MS=120000
TX_MAX_RETRIES=3
TX_RETRY_DELAY_MS=2000
GAS_LIMIT_BUFFER_PERCENT=20

# Legacy aliases (optional — used if primary vars not set)
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_PRIVATE_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
