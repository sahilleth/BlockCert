# ─── Wallet (deployer / contract admin) ───────────────────────────────────────
# Private key of the wallet that deploys and calls issueCertificate on-chain.
# NEVER commit the real .env file. Fund this wallet with Amoy MATIC from faucet.
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# ─── RPC Endpoints ────────────────────────────────────────────────────────────
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ─── Deployed Contract (fill after deployment) ────────────────────────────────
CONTRACT_ADDRESS=

# ─── Hardhat Local Node ───────────────────────────────────────────────────────
LOCALHOST_RPC_URL=http://127.0.0.1:8545
