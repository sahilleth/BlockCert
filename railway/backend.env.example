# Copy these into Railway → blockcert-api → Variables
# Replace placeholders before saving.

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Reference MySQL plugin in Railway UI: ${{MySQL.MYSQL_URL}}
DATABASE_URL=${{MySQL.MYSQL_URL}}

# Generate locally: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=7d

# Set after frontend is deployed
FRONTEND_URL=https://YOUR-FRONTEND.up.railway.app
ALLOWED_ORIGINS=https://YOUR-FRONTEND.up.railway.app

UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf

# Polygon Amoy — deploy contract first: npm run deploy:amoy
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
CONTRACT_ADDRESS=0xYourDeployedContractAddress
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

TX_TIMEOUT_MS=120000
TX_MAX_RETRIES=3
TX_RETRY_DELAY_MS=2000
GAS_LIMIT_BUFFER_PERCENT=20

STORAGE_PROVIDER=local
