{
  "name": "blockcert",
  "version": "1.0.0",
  "description": "BlockCert — Blockchain Based Certificate Verification System",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "blockchain"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "railway:seed": "npm run db:seed --workspace=@blockcert/backend",
    "railway:preflight": "node scripts/railway-preflight.mjs",
    "railway:docker:backend": "docker build -f Dockerfile.backend -t blockcert-api .",
    "railway:docker:frontend": "docker build -f Dockerfile.frontend -t blockcert-web .",
    "dev": "npm run start",
    "dev:frontend": "npm run dev --workspace=@blockcert/frontend",
    "dev:backend": "npm run dev --workspace=@blockcert/backend",
    "dev:blockchain": "npm run node --workspace=@blockcert/blockchain",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=@blockcert/frontend",
    "build:backend": "npm run build --workspace=@blockcert/backend",
    "compile:contracts": "npm run compile --workspace=@blockcert/blockchain",
    "deploy:amoy": "npm run deploy:amoy --workspace=@blockcert/blockchain",
    "deploy:local": "npm run deploy:local --workspace=@blockcert/blockchain",
    "test": "npm run test:contracts && npm run test:backend",
    "test:contracts": "npm run test --workspace=@blockcert/blockchain",
    "test:backend": "npm run test --workspace=@blockcert/backend",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "npm run db:migrate --workspace=@blockcert/backend",
    "db:seed": "npm run db:seed --workspace=@blockcert/backend",
    "generate:samples": "node demo/generate-sample-pdfs.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "vite": "8.1.3",
    "vitest": {
      "vite": "5.4.21"
    },
    "@vitest/mocker": {
      "vite": "5.4.21"
    },
    "vite-node": {
      "vite": "5.4.21"
    }
  },
  "devDependencies": {
    "wait-on": "^8.0.1"
  }
}
